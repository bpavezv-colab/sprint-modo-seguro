# Copia este archivo como .env y completa con una cuenta de Gmail de prueba.
# SMTP_PASS es una "contraseña de aplicación" de Google (no la contraseña normal):
# Cuenta de Google → Seguridad → Verificación en 2 pasos → Contraseñas de aplicaciones.
SMTP_USER=tu.cuenta.demo@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
ALERTA_PARA=casilla.demo@gmail.com
PORT=3000
